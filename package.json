{
  "name": "credjar",
  "version": "0.2.0",
  "private": true,
  "description": "Inspect, issue, and revoke Credly badges from the command line.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kallewesterling/credjar.git"
  },
  "bin": {
    "credjar": "bin/credjar.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "examples/",
    ".env-example"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "templates": "node scripts/list-templates.mjs",
    "templates:create": "node scripts/create-template.mjs",
    "badges": "node scripts/list-badges.mjs",
    "issue": "node scripts/issue-badges.mjs",
    "revoke": "node scripts/revoke-badges.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Kalle Westerling",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.8.4",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "yargs": "^17.7.2"
  }
}

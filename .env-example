# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real value here.

# An authorization token from Credly: Organization Management → Developers →
# Authorization Tokens. It grants full API access for the organization, so
# treat it like an admin password. Tokens expire after 180 days.
CREDLY_API_TOKEN=your-authorization-token

# Your organization's UUID, shown at the top of any tab in the Developers
# section.
CREDLY_ORG_ID=00000000-0000-0000-0000-000000000000

# production (api.credly.com) or sandbox (sandbox-api.credly.com).
# A token from one environment does not work in the other.
CREDLY_ENV=sandbox
